# Multica self-host configuration — mac-mini-m4
#
# This is the tracked template. deploy.sh copies it to .env on first run and
# fills the three secrets with random values. .env is gitignored and must never
# be committed.
#
# Derived from the upstream self-hosting guide (submodules/multica/SELF_HOSTING.md
# + SELF_HOSTING_ADVANCED.md). Kept as an independent copy so this node does not
# depend on the submodule being checked out.

# ─────────────────────────────────────────────────────────────────────────────
# Networking — LAN access
# ─────────────────────────────────────────────────────────────────────────────
# The origin browsers use. When the machine's LAN IP changes, update this,
# CORS_ALLOWED_ORIGINS, and MULTICA_DAEMON_SERVER_URL together, then restart.
FRONTEND_ORIGIN=http://192.168.50.248:3000

# The backend checks the WebSocket Origin header against an allowlist that
# defaults to localhost only. Without this, /ws upgrades are refused with 403
# and real-time features silently stop working, while ordinary HTTP keeps
# working — so the app looks fine until you notice comments never appear live.
CORS_ALLOWED_ORIGINS=http://192.168.50.248:3000

# The URL a remote daemon uses to reach the backend API, shown in the web UI's
# "Add a computer" instructions and consumed by `multica setup self-host`.
#
# This MUST be set explicitly on this deployment. Left empty, the backend falls
# back to MULTICA_APP_URL and then FRONTEND_ORIGIN (see daemonSetupURLsFromEnv
# in server/internal/handler/config.go), which would advertise the frontend
# origin. That is the right URL for a BROWSER, but a daemon does not talk to
# Next.js — it speaks /api/daemon/* to the Go backend. Advertising the frontend
# port means remote agents register against the wrong surface and never pick up
# work, with nothing in the daemon log saying why.
#
# Points at Caddy on 3000, not the backend's own 8080: the backend binds to
# loopback only, so 8080 is unreachable from other machines by design. Caddy
# forwards /api/daemon/* straight to the backend — see caddy/Caddyfile.
MULTICA_DAEMON_SERVER_URL=http://192.168.50.248:3000

# Caddy runs as a container on the multica-net bridge, so the source IP the
# backend sees is a Docker-network address, not host loopback. Trust that range
# so the webhook rate limiter reads X-Forwarded-For instead of the proxy IP.
# Remote daemons on the LAN also arrive through Caddy, so this stays correct
# for them too.
MULTICA_TRUSTED_PROXIES=172.16.0.0/12

# ─────────────────────────────────────────────────────────────────────────────
# Ports
# ─────────────────────────────────────────────────────────────────────────────
# Backend is published on host loopback for the multica CLI and for debugging.
BACKEND_PORT=8080

# Frontend is published on 3001, not 3000: Caddy owns 3000 as the single
# entry point on the LAN. See caddy/Caddyfile.
FRONTEND_PORT=3001

# ─────────────────────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_DB=multica
POSTGRES_USER=multica
# Filled by deploy.sh on first run. Not published to the host: only the backend
# container reaches Postgres, over the Compose network.
POSTGRES_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# Secrets — all three are generated by deploy.sh on first run
# ─────────────────────────────────────────────────────────────────────────────
# A production backend refuses to boot on an empty or known-placeholder value.
# Generate with: openssl rand -hex 32
JWT_SECRET=

# At-rest encryption key for self-hosted Git (Forgejo / Gitea / GitLab)
# integrations. Compose enables that integration by default on self-host.
# Generate with: openssl rand -base64 32
MULTICA_VCS_SECRET_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Images
# ─────────────────────────────────────────────────────────────────────────────
# Pin to an exact release (e.g. v0.4.10) if you want reproducible upgrades.
MULTICA_IMAGE_TAG=latest

# Mirror used for the GHCR prefix-rewrite pull in deploy.sh. registry-mirrors
# in ~/.docker/daemon.json covers Docker Hub only and does NOT proxy ghcr.io.
# Leave empty to pull from ghcr.io directly.
GHCR_MIRROR=docker.1ms.run

# ─────────────────────────────────────────────────────────────────────────────
# Runtime
# ─────────────────────────────────────────────────────────────────────────────
# production: no fixed verification code, and MULTICA_DEV_VERIFICATION_CODE is
# ignored. Login codes come from SMTP/Resend, or from the backend log.
APP_ENV=production

# Self-hosted API servers send one anonymous deployment snapshot per day to
# telemetry.multica.ai. Set to 1 to disable collection and delivery.
DO_NOT_TRACK=1

# ─────────────────────────────────────────────────────────────────────────────
# Email — needed for real login codes
# ─────────────────────────────────────────────────────────────────────────────
# SMTP_HOST takes priority over RESEND_API_KEY when set. With neither
# configured, verification codes are printed to the backend log instead.
# See README.md ("First login") for how to read them.

# Option A — SMTP relay (preferred for a LAN deployment)
SMTP_HOST=
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
# starttls (default) | implicit (port 465 auto-enables implicit)
SMTP_TLS=
# Set true to skip certificate verification (self-signed / private CA)
SMTP_TLS_INSECURE=false

# Option B — Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@multica.ai

# ─────────────────────────────────────────────────────────────────────────────
# Signup controls
# ─────────────────────────────────────────────────────────────────────────────
# Left open because this is a private LAN with no public exposure. If that ever
# changes, set DISABLE_WORKSPACE_CREATION=true after creating your workspace,
# and constrain ALLOWED_EMAIL_DOMAINS.
ALLOW_SIGNUP=true
DISABLE_WORKSPACE_CREATION=
ALLOWED_EMAIL_DOMAINS=