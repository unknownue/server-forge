# Multica agent runtime — configuration template.
#
# On the development machine:
#   cp .env.example .env    # then fill in the two required values
#   bash deploy.sh
#
# deploy.sh does this copy for you on first run. This file is tracked; .env is
# not (see the repo .gitignore).

# ─────────────────────────────────────────────────────────────────────────────
# Required — the Multica server this agent connects to
# ─────────────────────────────────────────────────────────────────────────────
# The server's LAN address. This is the Caddy entry point on the Multica host,
# which forwards /api/daemon/* to the backend. Do NOT point this at the
# backend's own port 8080 — that listens on the server's loopback only.
MULTICA_SERVER_URL=http://192.168.50.248:3000

# The browser-facing URL, used for links an agent posts back into comments.
MULTICA_APP_URL=http://192.168.50.248:3000

# Personal access token, created in the Multica web UI under
# Settings → API Token. Starts with `mul_`.
#
# Required because a container has no browser: `multica login` cannot complete
# the OAuth step, and this is the supported headless path. Treat it like a
# password — it grants access to every workspace and API your account can reach.
#
# On self-hosted instances the token dialog lives on your own server, not at
# multica.ai: open $MULTICA_APP_URL, sign in, then Settings → API Token.
MULTICA_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Required — where the code lives
# ─────────────────────────────────────────────────────────────────────────────
# Absolute path on THIS machine, bind-mounted to /repos read-write. This is
# what agents can change; nothing outside it is reachable from a run.
#
# Keep it narrow. Mounting $HOME or / would hand every run the developer's
# credentials, SSH keys and documents — precisely what running the daemon in a
# container is meant to avoid.
#
#   REPOS_DIR=/home/you/projects
REPOS_DIR=

# ─────────────────────────────────────────────────────────────────────────────
# Git identity for agent commits
# ─────────────────────────────────────────────────────────────────────────────
# Agents deliver work as a branch in your repository, so they must be able to
# commit. Set this to something you will recognise in `git log`.
GIT_AUTHOR_NAME=multica-agent
GIT_AUTHOR_EMAIL=multica-agent@localhost

# ─────────────────────────────────────────────────────────────────────────────
# Build options
# ─────────────────────────────────────────────────────────────────────────────
# amd64 on x86_64, arm64 on ARM. Get it with: uname -m
#   x86_64 -> amd64      aarch64 / arm64 -> arm64
TARGETARCH=arm64

# Pin the two versioned components. Multica's probe requires the DSH runtime
# protocol to report version 1, so DSH_VERSION should only move after checking
# that the bridge still builds against it.
MULTICA_VERSION=v0.5.2
DSH_VERSION=0.1.0-rc.6

# Optional prefix for the GitHub release download. Some networks reach
# api.github.com but not github.com; set this to a mirror such as
# "https://ghproxy.example/" if the build cannot fetch the CLI.
GH_PROXY=